# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 4

# Match multiple file types
[*.{js,ts,jsx,tsx,json,yml,yaml,md,css,scss,html}]
indent_size = 2

# PowerShell scripts
[*.{ps1,psm1,psd1}]
indent_style = space
indent_size = 4

# Windows batch files
[*.{bat,cmd}]
end_of_line = crlf
