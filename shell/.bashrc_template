# .bashrc_template
# This file is a template. Rename to .bashrc or .bash_profile

# Add your custom aliases here
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias gs='git status'
alias gp='git pull'

# Export variables
export EDITOR="code" # Or vim, nvim, etc.
export PATH="$HOME/bin:$PATH"

# Setup Starship prompt (if installed)
if command -v starship &> /dev/null; then
    eval "$(starship init bash)"
fi
