# Global git config — copy to ~/.gitconfig or include from it:
# [include]
#   path = /path/to/configs/git/.gitconfig

[user]
  name = Your Name
  # Set your real email only in ~/.gitconfig (do not commit it here).
  # GitHub noreply example: 12345678+USERNAME@users.noreply.github.com
  email = you@example.com

[core]
  autocrlf = input
  editor = code --wait
  whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol

[init]
  defaultBranch = main

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[rebase]
  autoStash = true

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default

[alias]
  st = status -sb
  co = checkout
  br = branch
  lg = log --oneline --graph --decorate --all
  undo = reset --soft HEAD~1
  # Commits staged files only — stage deliberately; avoid `git add -A` in aliases.
  wip = commit -m "wip"
  aliases = config --get-regexp alias

[color]
  ui = auto
